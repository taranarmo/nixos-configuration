{
  config,
  lib,
  pkgs,
  inputs,
  ...
}:

let
  flavor = config.catppuccin.flavor;
  accent = config.catppuccin.accent;

  palette =
    (builtins.fromJSON (builtins.readFile "${inputs.catppuccin-palette}/palette.json")).${flavor};
  colors = palette.colors;
  dark = palette.dark;

  hex = name: colors.${name}.hex;
  onColor = if dark then hex "crust" else hex "base";
  bgMinus = if dark then hex "surface0" else hex "mantle";
  bgPlus = if dark then hex "crust" else "#ffffff";

  catppuccinWebCss = pkgs.writeText "nyxt-catppuccin-web.css" ''
    /* Catppuccin ${flavor} (accent: ${accent}) stylesheet for Nyxt web pages.
     * Generated by modules/home-manager/nyxt.nix — do not edit directly.
     */
    :root {
      color-scheme: ${if dark then "dark" else "light"} !important;
    }

    html, body {
      background-color: ${hex "base"} !important;
      color: ${hex "text"} !important;
    }

    main, article, section, div, p, ul, ol, li, dl, dt, dd, figure, figcaption, form, fieldset, table, tr, td {
      background-color: ${hex "base"} !important;
      color: ${hex "text"} !important;
      border-color: ${hex "surface1"} !important;
    }

    header, nav, aside, footer, blockquote, details, summary, dialog, [role="dialog"], [role="menu"], [role="listbox"], [role="tooltip"] {
      background-color: ${hex "mantle"} !important;
      color: ${hex "text"} !important;
      border-color: ${hex "surface1"} !important;
    }

    h1, h2, h3, h4, h5, h6 {
      color: ${hex "text"} !important;
    }

    a, a:link {
      color: ${hex "blue"} !important;
    }
    a:visited {
      color: ${hex "mauve"} !important;
    }
    a:hover, a:active {
      color: ${hex "sky"} !important;
    }

    input, textarea, select, button, [contenteditable] {
      background-color: ${hex "surface0"} !important;
      color: ${hex "text"} !important;
      border-color: ${hex "surface2"} !important;
    }

    pre, code, kbd, samp, tt {
      background-color: ${hex "mantle"} !important;
      color: ${hex "text"} !important;
      border-color: ${hex "surface1"} !important;
    }

    th {
      background-color: ${hex "surface0"} !important;
      color: ${hex "text"} !important;
    }
    tr:nth-child(even) {
      background-color: ${hex "mantle"} !important;
    }
    hr {
      border-color: ${hex "surface1"} !important;
    }

    ::selection {
      background-color: ${hex "surface2"} !important;
      color: ${hex "text"} !important;
    }

    img, video, picture, canvas, svg, svg *, iframe, embed, object {
      background-color: transparent !important;
    }
  '';
in
{
  xdg.configFile."nyxt/catppuccin-web.css".source = catppuccinWebCss;

  programs.nyxt = {
    enable = true;
    config = ''
      ;;;; Nyxt configuration managed by Home Manager (modules/home-manager/nyxt.nix).
      (in-package #:nyxt-user)

      ;; Catppuccin ${flavor} (accent: ${accent}) UI theme.
      (define-configuration browser
        ((theme
          (make-instance 'theme:theme
                         :background-color- "${bgMinus}"
                         :background-color "${hex "base"}"
                         :background-color+ "${bgPlus}"
                         :on-background-color "${hex "text"}"
                         :primary-color- "${hex "lavender"}"
                         :primary-color "${hex accent}"
                         :primary-color+ "${hex "pink"}"
                         :on-primary-color "${onColor}"
                         :secondary-color- "${hex "surface2"}"
                         :secondary-color "${hex "surface1"}"
                         :secondary-color+ "${hex "surface0"}"
                         :on-secondary-color "${hex "text"}"
                         :action-color- "${hex "sky"}"
                         :action-color "${hex "blue"}"
                         :action-color+ "${hex "sapphire"}"
                         :on-action-color "${onColor}"
                         :highlight-color- "${hex "peach"}"
                         :highlight-color "${hex "yellow"}"
                         :highlight-color+ "${hex "rosewater"}"
                         :on-highlight-color "${onColor}"
                         :success-color- "${hex "teal"}"
                         :success-color "${hex "green"}"
                         :success-color+ "${hex "teal"}"
                         :on-success-color "${onColor}"
                         :warning-color- "${hex "maroon"}"
                         :warning-color "${hex "red"}"
                         :warning-color+ "${hex "peach"}"
                         :on-warning-color "${onColor}"
                         :codeblock-color- "${hex "surface0"}"
                         :codeblock-color "${hex "mantle"}"
                         :codeblock-color+ "${hex "crust"}"
                         :on-codeblock-color "${hex "text"}"
                         :text-color- "${hex "subtext0"}"
                         :text-color "${hex "subtext1"}"
                         :text-color+ "${hex "text"}"
                         :contrast-text-color "${onColor}"
                         :font-family "Arimo Nerd Font"
                         :monospace-font-family "JetBrainsMono Nerd Font"))))

      ;; Vi keybindings across buffers and prompts, with vi-style link hinting.
      (define-configuration input-buffer
        ((default-modes (pushnew 'nyxt/mode/vi:vi-normal-mode %slot-value%))))

      (define-configuration prompt-buffer
        ((default-modes (pushnew 'nyxt/mode/vi:vi-insert-mode %slot-value%))))

      (define-configuration nyxt/mode/hint:hint-mode
        ((nyxt/mode/hint:hinting-type :vi)))

      ;; Catppuccin webpage styling via dark-mode (toggle per-buffer or with auto-rules).
      (define-configuration web-buffer
        ((default-modes (pushnew 'nyxt/mode/style:dark-mode %slot-value%))))

      (define-configuration nyxt/mode/style:dark-mode
        ((style (uiop:read-file-string "${catppuccinWebCss}"))))

      ;; Custom search engines matching Firefox (DuckDuckGo last = default).
      (define-configuration context-buffer
        ((search-engines
          (append
           (list
            (make-instance 'search-engine
                           :name "Nix Packages"
                           :shortcut "np"
                           :search-url "https://search.nixos.org/packages?type=packages&query=~a"
                           :fallback-url (quri:uri "https://search.nixos.org/packages"))
            (make-instance 'search-engine
                           :name "NixOS Options"
                           :shortcut "no"
                           :search-url "https://search.nixos.org/options?type=packages&query=~a"
                           :fallback-url (quri:uri "https://search.nixos.org/options"))
            (make-instance 'search-engine
                           :name "Home Manager Options"
                           :shortcut "hm"
                           :search-url "https://home-manager-options.extranix.com/?query=~a"
                           :fallback-url (quri:uri "https://home-manager-options.extranix.com/"))
            (make-instance 'search-engine
                           :name "GitHub"
                           :shortcut "gh"
                           :search-url "https://github.com/search?q=~a"
                           :fallback-url (quri:uri "https://github.com/")))
           (remove "a" %slot-value% :key #'shortcut :test #'string=)))))
    '';
  };
}
